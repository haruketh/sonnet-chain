# Paths only; never commit secret values.
SONNET_SEED_FILE=/absolute/path/to/saruku-seed
SONNET_OPENAI_API_KEY_FILE=/absolute/path/to/openai-api-key
SONNET_MODEL=gpt-5.1
SONNET_X_ACCOUNT_URL=https://x.com/sarukubt
# Executable receives {"posts":[...]} on stdin and returns {"post_ids":[...]}.
SONNET_X_PUBLISH_CMD=/absolute/path/to/publisher-adapter
SONNET_X_TOKEN_FILE=/absolute/path/to/x-token-json
SONNET_X_CLIENT_ID_FILE=/absolute/path/to/client-id
SONNET_X_CLIENT_SECRET_FILE=/absolute/path/to/client-secret
SONNET_X_REDIRECT_URI=http://127.0.0.1:8765/callback
SONNET_X_EXPECTED_USERNAME=sarukubt
SONNET_X_PUBLISH_STATE_DB=state/publisher.sqlite3

# Filled from the signed FLOP Labs launch announcement:
SONNET_REFEREE_DID=

# Local official package checkout and candidate manifest pin:
SONNET_OFFICIAL_DIR=.official/technocore-sonnet-challange
SONNET_OFFICIAL_COMMIT=e1999094c359ef7390bdf07fe2a151393a5c2f51
SONNET_MANIFEST_SHA256=0c87c41b8b33bdd8641f77c9e481a12f2758a0e27d47b90452b1c0a2020a9547
SONNET_STATE_DB=state/sonnet-chain.sqlite3

TECHNOCORE_URL=https://technocore.chat
